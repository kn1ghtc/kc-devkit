{
  "name": "kc-devkit",
  "displayName": "KC DevKit",
  "description": "Comprehensive developer toolkit: Markdown preview (KaTeX + Mermaid + TOC), PDF preview (pdf.js canvas with CJK cmaps and math fonts), Excel/CSV preview (xlsx/xls/csv with freeze panes and wrap), PowerPoint preview (ppt/pptx slide rendering), code formatting (JS/JSON/CSS/HTML), Python cache cleaner, and SageMath support with WSL integration.",
  "version": "1.5.0",
  "publisher": "kn1ghtc",
  "author": {
    "name": "kn1ghtc"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kn1ghtc/kc-devkit.git"
  },
  "homepage": "https://github.com/kn1ghtc/kc-devkit#readme",
  "bugs": {
    "url": "https://github.com/kn1ghtc/kc-devkit/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Formatters",
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "mermaid",
    "katex",
    "pdf",
    "pdfjs",
    "excel",
    "xlsx",
    "csv",
    "spreadsheet",
    "powerpoint",
    "pptx",
    "ppt",
    "cjk",
    "latex",
    "preview",
    "beautify",
    "formatter",
    "pycache",
    "sagemath",
    "sage",
    "math",
    "developer-tools"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "qna": "marketplace",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:css",
    "onLanguage:less",
    "onLanguage:scss",
    "onLanguage:html",
    "onCustomEditor:kcDevKit.pdfPreview",
    "onCustomEditor:kcDevKit.excelPreview",
    "onCustomEditor:kcDevKit.pptPreview"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./styles/katex.min.css",
      "./styles/mermaid.css",
      "./styles/line-number.css",
      "./styles/toc.css"
    ],
    "markdown.previewScripts": [
      "./preview-scripts/mermaid.min.js",
      "./preview-scripts/mermaid-init.js",
      "./preview-scripts/toc-init.js"
    ],
    "customEditors": [
      {
        "viewType": "kcDevKit.pdfPreview",
        "displayName": "KC DevKit PDF Preview",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "kcDevKit.excelPreview",
        "displayName": "KC DevKit Excel Preview",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.xls"
          },
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "kcDevKit.pptPreview",
        "displayName": "KC DevKit PPT Preview",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          },
          {
            "filenamePattern": "*.ppt"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "kcDevKit.refreshToc",
        "title": "Refresh Markdown TOC",
        "category": "KC DevKit",
        "icon": "$(refresh)"
      },
      {
        "command": "kcDevKit.beautifyFile",
        "title": "Beautify File",
        "category": "KC DevKit"
      },
      {
        "command": "kcDevKit.beautifySelection",
        "title": "Beautify Selection",
        "category": "KC DevKit"
      },
      {
        "command": "kcDevKit.cleanPycache",
        "title": "Clean Python Cache Files",
        "category": "KC DevKit",
        "icon": "$(trash)"
      },
      {
        "command": "kcDevKit.runSageFile",
        "title": "Run SageMath File",
        "category": "KC DevKit",
        "icon": "$(play)"
      },
      {
        "command": "kcDevKit.openPdfPreview",
        "title": "Open PDF Preview",
        "category": "KC DevKit",
        "icon": "$(file-pdf)"
      },
      {
        "command": "kcDevKit.openExcelPreview",
        "title": "Open Excel Preview",
        "category": "KC DevKit",
        "icon": "$(table)"
      },
      {
        "command": "kcDevKit.openPptPreview",
        "title": "Open PPT Preview",
        "category": "KC DevKit",
        "icon": "$(file-media)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "kcDevKitToc",
          "name": "Markdown Outline",
          "when": "resourceLangId == markdown"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kcDevKit.refreshToc",
          "when": "view == kcDevKitToc",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "kcDevKit.runSageFile",
          "when": "resourceLangId == sage",
          "group": "navigation"
        },
        {
          "command": "kcDevKit.openPdfPreview",
          "when": "resourceExtname == .pdf",
          "group": "navigation"
        },
        {
          "command": "kcDevKit.openExcelPreview",
          "when": "resourceExtname == .xlsx || resourceExtname == .xlsm || resourceExtname == .xls || resourceExtname == .csv",
          "group": "navigation"
        },
        {
          "command": "kcDevKit.openPptPreview",
          "when": "resourceExtname == .ppt || resourceExtname == .pptx",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "kcDevKit.runSageFile",
          "when": "resourceLangId == sage"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kcDevKit.cleanPycache",
        "key": "ctrl+shift+p ctrl+shift+c",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "languages": [
      {
        "id": "sage",
        "aliases": [
          "SageMath",
          "sage"
        ],
        "extensions": [
          ".sage",
          ".sagews"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sage",
        "scopeName": "source.sage",
        "path": "./syntaxes/sage.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sage",
        "path": "./snippets/sage.json"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.pdf": "kcDevKit.pdfPreview",
        "*.xlsx": "kcDevKit.excelPreview",
        "*.xlsm": "kcDevKit.excelPreview",
        "*.xls": "kcDevKit.excelPreview",
        "*.csv": "kcDevKit.excelPreview",
        "*.pptx": "kcDevKit.pptPreview",
        "*.ppt": "kcDevKit.pptPreview"
      }
    },
    "configuration": {
      "title": "KC DevKit",
      "properties": {
        "kcDevKit.markdown.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Markdown Ultra features (KaTeX, Mermaid, TOC, line numbers)"
        },
        "kcDevKit.beautify.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable code beautify/formatting features"
        },
        "kcDevKit.beautify.language": {
          "type": "object",
          "default": {
            "js": {
              "type": [
                "javascript",
                "javascriptreact",
                "json",
                "jsonc"
              ]
            },
            "css": {
              "type": [
                "css",
                "less",
                "scss"
              ]
            },
            "html": {
              "type": [
                "html"
              ]
            }
          },
          "description": "Language to beautifier type mapping"
        },
        "kcDevKit.beautify.ignore": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns to ignore when formatting"
        },
        "kcDevKit.pycache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Python cache cleaner features"
        },
        "kcDevKit.pycache.autoCleanOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically clean __pycache__ and .pyc files when workspace opens"
        },
        "kcDevKit.pycache.exclude": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.venv/**",
            "**/venv/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns to exclude from pycache cleanup"
        },
        "kcDevKit.sagemath.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable SageMath support features"
        },
        "kcDevKit.sagemath.interpreterPath": {
          "type": "string",
          "default": "sage",
          "description": "Path to the SageMath interpreter"
        },
        "kcDevKit.sagemath.useWSL": {
          "type": "boolean",
          "default": false,
          "description": "Use WSL to run SageMath on Windows"
        },
        "kcDevKit.sagemath.autoDeleteGenerated": {
          "type": "boolean",
          "default": false,
          "description": "Auto-delete .sage.py files generated by SageMath"
        },
        "kcDevKit.pdf.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable PDF preview (pdf.js canvas with CJK cmaps and standard fonts)"
        },
        "kcDevKit.pdf.defaultScale": {
          "type": "string",
          "default": "page-width",
          "description": "Default PDF zoom: page-width, page-fit, or a numeric scale such as 1.25"
        },
        "kcDevKit.excel.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Excel/CSV preview custom editor (xlsx, xlsm, xls, csv)"
        },
        "kcDevKit.ppt.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable PowerPoint preview custom editor (ppt, pptx)"
        }
      }
    }
  },
  "scripts": {
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "package": "npx @vscode/vsce package --no-dependencies",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "smoke:pdf": "node scripts/smoke-pdf.mjs",
    "smoke:excel": "node scripts/smoke-excel.mjs",
    "smoke:ppt": "node scripts/smoke-ppt.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@types/node": "^20.11.16",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.24.2",
    "ovsx": "^0.10.6",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "js-beautify": "^1.15.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.21",
    "mermaid": "^11.4.1",
    "pdfjs-dist": "4.10.38",
    "xlsx": "0.18.5"
  }
}
