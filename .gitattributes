# 统一文本文件行尾为 LF（跨平台一致，消除 CRLF↔LF churn）
* text=auto eol=lf

# Windows 专用脚本保留 CRLF；Shell 脚本强制 LF（跨平台 mac/win）
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

# 二进制文件（禁止行尾转换）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.vsix binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
